# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าตามต้องการ

# ollama = ฟรี รันในเครื่อง (ต้องติดตั้ง Ollama และรัน `ollama pull gemma4:12b`)
# claude = Claude API (ต้องมี API key และเครดิต)
LLM_PROVIDER=ollama

# ---- Ollama ----
OLLAMA_MODEL=gemma4:12b
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_NUM_CTX=16384
# OLLAMA_THINK=false

# ---- Claude ----
# ANTHROPIC_API_KEY=  (สร้างได้ที่ https://console.anthropic.com)
# CLAUDE_MODEL=claude-opus-5-5
